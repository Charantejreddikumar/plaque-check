# PlaqueCheck Backend Environment Configuration
# Copy this file to .env and configure your live Supabase credentials.

# 1. Supabase PostgreSQL Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# OR Session Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternative env keys supported by PlaqueCheck:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. JWT Secret Key
JWT_SECRET=super-secret-plaquecheck-key-2026

# 3. Server Configuration
HOST=127.0.0.1
PORT=8000
